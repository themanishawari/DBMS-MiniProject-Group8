# ==============================================================================
# College Complaint Management System (CCMS) - Environment Configuration
# ==============================================================================

# Data Provider Mode:
# 'mock' (Default for frontend prototype with localStorage persistence & 22 seed records)
# 'api' (Connects to real FastAPI / PostgreSQL backend)
VITE_DATA_PROVIDER=mock

# Base URL for REST API (Active when VITE_DATA_PROVIDER=api)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Institutional Portal Info
VITE_COLLEGE_NAME=Engineering College CCMS
VITE_PORTAL_VERSION=1.0.0
